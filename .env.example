DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=phishing_awareness_tracker

BASE_URL=http://YOUR-LAN-IP:5055

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=security@example.com
SMTP_FROM_NAME=Security Awareness Team

# Optional SMTP-provider-approved aliases (comma separated). Never user-entered.
SMTP_ALLOWED_FROM_EMAILS=

# Stable signing key; operator sessions currently require one process. Local development generates
# an ignored instance/session.key when this is unset.
SECRET_KEY=
# Set to 1 when served over HTTPS.
SESSION_COOKIE_SECURE=0
# MySQL port (local Docker setup uses 3307).
DB_PORT=3306

# Fernet key for saved sender passwords; generate once following docs/sender-accounts.md.
# Keep outside the database and source control. Do not rotate without re-encryption.
SENDER_ENCRYPTION_KEY=
# Existing configured sender supports starttls or ssl when selected as a saved account.
SMTP_TLS_MODE=starttls

# Administrative access is disabled until both values are configured.
# Generate the hash interactively: flask --app app hash-operator-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
OPERATOR_SESSION_MINUTES=30
APP_ENV=local
APP_HOST=127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Production requires APP_ENV=production, explicit trusted hostnames,
# SESSION_COOKIE_SECURE=1 and a random SECRET_KEY of at least 32 characters.
